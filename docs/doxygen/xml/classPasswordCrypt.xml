      <memberdef kind="function" id="classPasswordCrypt_1aaa1e7f7eec2be8279ba7330313001546" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>std::optional&lt; std::string &gt;</type>
        <definition>std::optional&lt; std::string &gt; PasswordCrypt::hashPassword</definition>
        <argsstring>(const std::string &amp;password)</argsstring>
        <name>hashPassword</name>
        <qualifiedname>PasswordCrypt::hashPassword</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>password</declname>
