        <name>CRITICALMESSAGERESPONSE</name>
        <initializer><ref refid="global_8hpp_1a68447123f2c27bb7bcdbbaec4091dab7" kindref="member">CRITICALMESSAGE</ref>                                             \
callback(<ref refid="namespaceapi_1_1v2_1_1Http_1aaddeb034a51d7050d6cc65cc2b46fdcf" kindref="member">api::v2::Http::statusForException</ref>(e),              \
