        <definition>static std::shared_ptr&lt; T &gt; Store::getObject</definition>
        <argsstring>(Args &amp;&amp;... args)</argsstring>
        <name>getObject</name>
        <qualifiedname>Store::getObject</qualifiedname>
        <param>
          <type>Args &amp;&amp;...</type>
          <declname>args</declname>
