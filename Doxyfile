# Doxygen configuration for Project Valhalla (C++20 / Drogon HTTP server).
#
# Generated documentation is written to docs/doxygen/ (published alongside the
# API docs). That directory is excluded from INPUT so Doxygen never ingests its
# own output. Run with:  doxygen Doxyfile  (or the valhalla_doxygen CMake target)

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "Valhalla Server"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Enterprise healthcare scheduling REST API built on Drogon and PostgreSQL"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         docs/ARCHITECTURE.md \
                         docs/CONTRIBUTING.md \
                         src
FILE_PATTERNS          = *.cpp *.hpp *.h *.md
RECURSIVE              = YES
EXCLUDE                = build \
                         docs/doxygen \
                         tools/docs/node_modules \
                         .git \
                         .github
EXCLUDE_SYMLINKS       = NO
EXCLUDE_PATTERNS       = */node_modules/* */build/* *.in
STRIP_FROM_PATH        = .
USE_MDFILE_AS_MAINPAGE = README.md

#---------------------------------------------------------------------------
# Extraction — everything, including private/statics/anonymous namespaces,
# so that implementation details are documented for maintainers.
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/doxygen/warnings.log

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_DOCBOOK       = NO

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES
SHOW_INCLUDE_FILES     = YES

#---------------------------------------------------------------------------
# Graphs — disabled by default: they are expensive and add little value for
# this codebase. Enable HAVE_DOT and the desired graphs on demand.
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GROUP_GRAPHS           = NO
DIRECTORY_GRAPH        = NO

#---------------------------------------------------------------------------
# Preprocessing — Drogon/conan headers are not part of the documentation,
# so keep preprocessing minimal but expand our own macros.
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = VALHALLA_GIT_TAG="\"dev\"" \
                         __attribute(x)=

#---------------------------------------------------------------------------
# Markdown
#---------------------------------------------------------------------------
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
