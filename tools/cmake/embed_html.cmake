# embed_html(INPUT <file> OUTPUT <header> [VARIABLE <name>] [NAMESPACE <ns>])
#
# Turns a text file (here: docs/api.html, the Swagger UI page) into a C++ header holding it as a
#   inline constexpr std::string_view <VARIABLE>   (backed by a constexpr char array <VARIABLE>Data)
# so the server binary carries the page and does not read anything from disk at run time.
#
# Called at configure time (so the header exists) and again at build time by tools/cmake/build_docs.cmake.
# The output file is only rewritten when its content changes, so unchanged pages do not trigger a rebuild.
include_guard(GLOBAL)

function(embed_html)
  cmake_parse_arguments(ARG "" "INPUT;OUTPUT;VARIABLE;NAMESPACE" "" ${ARGN})
  if(NOT ARG_INPUT OR NOT ARG_OUTPUT)
    message(FATAL_ERROR "embed_html: INPUT and OUTPUT are required")
  endif()
  if(NOT ARG_VARIABLE)
    set(ARG_VARIABLE "kHtml")
  endif()
  if(NOT ARG_NAMESPACE)
    set(ARG_NAMESPACE "embedded")
  endif()

  get_filename_component(input_abs "${ARG_INPUT}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")

  if(EXISTS "${input_abs}")
    file(READ "${input_abs}" content)
  else()
    message(WARNING "embed_html: ${input_abs} not found, embedding a placeholder page")
    set(content "<!doctype html><title>API docs</title><p>docs/api.html was not found when the server was built.</p>")
  endif()

  set(delim "VALHALLA_HTML")
  string(FIND "${content}" ")${delim}\"" clash)
  if(NOT clash EQUAL -1)
    message(FATAL_ERROR "embed_html: ${input_abs} contains the raw-string terminator )${delim}\"")
  endif()

  set(tmp "${ARG_OUTPUT}.tmp")
  file(WRITE "${tmp}"
"// Generated by tools/cmake/embed_html.cmake from ${ARG_INPUT}. Do not edit.
#pragma once

#include <string_view>

namespace ${ARG_NAMESPACE}
{
// One big string literal on purpose; compilers accept it, -pedantic only warns about the 64 KiB portability limit.
#if defined(__GNUC__) || defined(__clang__)
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored \"-Woverlength-strings\"
#endif
inline constexpr char ${ARG_VARIABLE}Data[] = R\"${delim}(${content})${delim}\";
#if defined(__GNUC__) || defined(__clang__)
#pragma GCC diagnostic pop
#endif
// Explicit size: constructing a string_view from the bare literal would make the compiler scan 2 MB with strlen.
inline constexpr std::string_view ${ARG_VARIABLE}{${ARG_VARIABLE}Data, sizeof(${ARG_VARIABLE}Data) - 1};
}  // namespace ${ARG_NAMESPACE}
")
  # configure_file(COPYONLY) only touches the destination when the content differs.
  configure_file("${tmp}" "${ARG_OUTPUT}" COPYONLY)
  file(REMOVE "${tmp}")
endfunction()
