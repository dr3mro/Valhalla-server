# Define maximum number of requests in period
MAX_REQUESTS=10000000

# Define period in seconds
PERIOD=30

# Define maximum FPS (fingerprints per ip per period)
MAX_FPS=3000000

# Define rate limit duration in seconds
RL_DURATION=30

# Define ban duration in seconds
BAN_DURATION=3600

# Define cleanup frequency in seconds
CLN_FRQ=30

# Define whitelist IPs (comma-separated)
WHITELIST="0.0.0.0,127.0.0.1"

# Define blacklist IPs (comma-separated)
BLACKLIST=""

# Database
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASS="postgres"
DB_SSL="false"

# connections pool size
DB_MAX_CONN=10

# Milliseconds a request waits for a free database connection before it gets 503 (keep DB_MAX_CONN >= SERVER_THREADS + 1)
DB_ACQUIRE_TIMEOUT_MS=3000

# DB_ASYNC: asynchronous database access (Drogon orm::DbClient coroutines on the IO threads).
# true = default; false = legacy synchronous libpqxx pool behind the DB executor (kept for one release).
DB_ASYNC=true

# Permission cache: seconds an unused cached permission is kept (0 disables)
PERMISSION_CACHE_TTL=300

# Password hashing and login checks run on these threads, not on the request threads (keep it below DB_MAX_CONN)
PASSWORD_WORKERS=2
# Password operations that may wait for a worker; more than this get 503
PASSWORD_QUEUE_MAX=64

# Database work runs on these threads, not on the request threads (legacy DB_ASYNC=false path only)
# DB_WORKERS=10
# Requests that may wait for a database worker; more than this get 503 (legacy DB_ASYNC=false path only)
DB_QUEUE_MAX=256
# Try each request on the IO thread first, queue it only if it needs the database (legacy DB_ASYNC=false path only)
DB_IO_FASTPATH=true

# threads
SERVER_THREADS=10
SERVER_HOST="0.0.0.0"
SERVER_PORT=8080
CONTAINER_PORT=8080
SERVER_NAME="ProjectValhalla"
SERVER_DESCRIPTION="ProjectValhalla API"
SERVER_DEBUG_LEVEL=1 # 0 Debug 1 info 2 warning 3 error 4 critical
SERVER_LOG_FILE="server.log"
SERVER_LOG_DIR="./logs/valhalla/"
SERVER_UPLOAD_DIR="./uploads/"
SERVER_LOG_TO_CONSOLE="true"
SERVER_LOG_TO_FILE="true"
VALHALLA_TEST_NO_DB="false"

# TokenParameters
TOKEN_ISSUER="ProjectValhalla"
TOKEN_TYPE="JWS"
TOKEN_VALIDITY=600
TOKEN_SECRET="5809d36870431c2c38ae29b7399ed2a291f985aba01ee76ef5711f9147ba8d00"

# FrontEndConfiguration
FRONTEND_HOST="http://172.20.0.30"
FRONTEND_PORT=3000
FRONTEND_INVITE_PATH="invite"

# EmailSenderConfiguration
EMAIL_SENDER_HOST="http://172.20.0.6"
EMAIL_SENDER_PORT=5000
EMAIL_SENDER_QUEUE_PATH="/enqueue"
