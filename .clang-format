# Optimized C++ formatting configuration
# Baseline: Google style, with deliberate project-specific overrides.
# Recommended: clang-format 18 or newer.

---
Language: Cpp
BasedOnStyle: Google

# -----------------------------------------------------------------------------
# General layout
# -----------------------------------------------------------------------------
ColumnLimit: 80
IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 4

# Keep opening braces on the same line as the declaration (Attach style).
BreakBeforeBraces: Attach

# Prefer readable multi-line argument and parameter lists over dense packing.
BinPackArguments: false
BinPackParameters: AlwaysOnePerLine
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
AlignAfterOpenBracket: Align
PenaltyBreakBeforeFirstCallParameter: 2000

# -----------------------------------------------------------------------------
# Alignment and whitespace
# -----------------------------------------------------------------------------
PointerAlignment: Left
ReferenceAlignment: Pointer
DerivePointerAlignment: false

SpaceBeforeParens: ControlStatements
SpaceBeforeAssignmentOperators: true
SpacesInAngles: Never
SpacesInContainerLiterals: true
SpaceAfterTemplateKeyword: true

# Align only adjacent code; do not let comments or blank lines create
# unexpectedly large alignment groups.
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveBitFields: Consecutive
AlignTrailingComments:
  Kind: Always
SpacesBeforeTrailingComments: 2

# -----------------------------------------------------------------------------
# C++ constructs
# -----------------------------------------------------------------------------
IndentCaseLabels: true
AccessModifierOffset: -1
ConstructorInitializerIndentWidth: 4
BreakConstructorInitializers: BeforeColon
BreakInheritanceList: BeforeColon
BreakTemplateDeclarations: Yes
BitFieldColonSpacing: Both

# Keep short constructs expanded for easier review, debugging, and diffs.
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: None
AllowShortLoopsOnASingleLine: false

BreakBeforeTernaryOperators: true
AlwaysBreakBeforeMultilineStrings: true
BreakStringLiterals: true

# -----------------------------------------------------------------------------
# Includes and using declarations
# -----------------------------------------------------------------------------
IncludeBlocks: Regroup
IncludeCategories:
  # Project/vendor headers under ext/ are kept in their own group.
  - Regex: "^<ext/.*>"
    Priority: 1
  # Angle-bracket headers ending in .h (commonly system/C headers).
  - Regex: '^<.*\.h>'
    Priority: 2
  # Other angle-bracket headers (standard library and third-party headers).
  - Regex: "^<.*>"
    Priority: 3
  # Quoted project headers.
  - Regex: '".*"'
    Priority: 4

SortUsingDeclarations: LexicographicNumeric

# -----------------------------------------------------------------------------
# Comments, preprocessor directives, and file hygiene
# -----------------------------------------------------------------------------
CommentPragmas: "^ IWYU pragma:"
ReflowComments: Always
NamespaceIndentation: All
FixNamespaceComments: true
IndentPPDirectives: AfterHash
MaxEmptyLinesToKeep: 1
Standard: Auto
InsertNewlineAtEOF: true
LineEnding: LF
