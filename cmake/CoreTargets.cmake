# Sources, server_core library, version refresh target and server executable.

# Find all source files.
# cmake_configure_depends re-runs cmake automatically when the
# file list changes, so adding or removing a .cpp file is
# picked up without a manual reconfigure.
file(GLOB_RECURSE SRC "src/*.cpp")
set_property(DIRECTORY APPEND
  PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_SOURCE_DIR}/src")

# Collect the main() translation unit separately so that the rest of the code
# can be linked into the test executable as well.
set(SRC_MAIN "${CMAKE_CURRENT_SOURCE_DIR}/src/main.cpp")
list(FILTER SRC EXCLUDE REGEX "src/main\\.cpp$")

# Core library: everything except main(). Tests link against this.
# version.cpp is generated by configure_file above.
add_library(server_core STATIC ${SRC} "${CMAKE_CURRENT_BINARY_DIR}/version.cpp")

# Refresh version.cpp on every build (cheap; the file is only rewritten when
# the tag changed, and BYPRODUCTS lets Ninja skip relinking when it didn't).
add_custom_target(
  valhalla_version
  COMMAND ${CMAKE_COMMAND} -DSOURCE_DIR=${CMAKE_SOURCE_DIR}
  -DBINARY_DIR=${CMAKE_BINARY_DIR}
  -P ${CMAKE_SOURCE_DIR}/tools/cmake/gen_version.cmake
  BYPRODUCTS ${CMAKE_BINARY_DIR}/version.cpp
  VERBATIM)
add_dependencies(server_core valhalla_version)

# Executable: main() + core. Output name/path unchanged (build/<type>/server).
add_executable(${TARGET} ${SRC_MAIN})
target_link_libraries(${TARGET} PRIVATE server_core)
