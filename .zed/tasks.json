[
  {
    "label": "Conan install dependencies Debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "conan",
    "args": ["install", ".", "--build=missing", "-s", "build_type=Debug"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "Conan install dependencies Release",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "conan",
    "args": ["install", ".", "--build=missing", "-s", "build_type=Release"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "Configure Debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "cmake",
    "args": [
      "-S",
      ".",
      "-B",
      "build/Debug",
      "-DCMAKE_BUILD_TYPE=Debug",
      "-DCMAKE_C_COMPILER=clang",
      "-DCMAKE_CXX_COMPILER=clang++",
      "-G",
      "Ninja",
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "Configure Release",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "cmake",
    "args": [
      "-S",
      ".",
      "-B",
      "build/Release",
      "-DCMAKE_BUILD_TYPE=Release",
      "-DCMAKE_C_COMPILER=clang",
      "-DCMAKE_CXX_COMPILER=clang++",
      "-G",
      "Ninja",
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "Build Debug",
    "command": "ninja",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["-C", "$ZED_WORKTREE_ROOT/build/Debug", "-j", "8"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "Build Release",
    "command": "ninja",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["-C", "$ZED_WORKTREE_ROOT/build/Release", "-j", "8"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "Run Debug",
    "command": "$ZED_WORKTREE_ROOT/build/Debug/server",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "shell": "system",
  },
  {
    "label": "Run Release",
    "command": "$ZED_WORKTREE_ROOT/build/Release/server",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "shell": "system",
  },
  {
    "label": "Debug (lldb)",
    "command": "sudo",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["lldb", "$ZED_WORKTREE_ROOT/build/Debug/server"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "shell": "system",
  },
  {
    "label": "Clean Build Directory",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "rm",
    "args": ["-rf", "build/"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "Init Database",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "psql",
    "args": [
      "-h",
      "127.0.0.1",
      "-U",
      "postgres",
      "-d",
      "postgres",
      "-f",
      "init.sql",
    ],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "shell": "system",
  },
]
